# Server-only; never use NEXT_PUBLIC_ for the backend target or credentials.
CONTROL_API_URL=http://127.0.0.1:8092
PLATFORM_HOST=platform.localhost

# School portals are served independently of this admin app.
NEXT_PUBLIC_TENANT_PORTAL_PORT=8091
# http://platform.localhost:3005/platform
# Server-only; use the SAME random >=32-byte value on backend and both Next.js projects.
# Required in production to pass portal identity safely through Cloudflare.
PORTAL_PROXY_SECRET=
